NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storefront (optional)
# Number used for the WhatsApp buttons. Defaults to the phone in Settings (shop_settings.phone).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Enables AI answers on the "Ask Amil" page. Without it, Ask Amil recommends from catalogue search only.
ANTHROPIC_API_KEY=
# Model used by Ask Amil (defaults to claude-opus-5). Pick a smaller model to reduce cost.
ASK_AMIL_MODEL=

# Online payments with PayHere (optional; enable it under Online Store > Payments)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Public URL of the website, used for PayHere return/notify links (e.g. https://amilautohub.lk)
NEXT_PUBLIC_SITE_URL=
