NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required: signs customer login session cookies (separate from Supabase Auth, which is
# staff-only in this project). Generate a random value, e.g. `openssl rand -hex 32`.
CUSTOMER_SESSION_SECRET=

# Storefront (optional)
# Number used for the WhatsApp buttons. Defaults to the phone in Settings (shop_settings.phone).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Enables AI answers on the "Ask Amil" page. Without it, Ask Amil recommends from catalogue search only.
ANTHROPIC_API_KEY=
# Model used by Ask Amil (defaults to claude-opus-5). Pick a smaller model to reduce cost.
ASK_AMIL_MODEL=

# "Continue with Google" on the sign-in/register pages (optional). Create an OAuth Client
# ID in Google Cloud Console > APIs & Services > Credentials, with this authorized redirect
# URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback (e.g. http://localhost:3001/api/auth/google/callback for local dev).
# Without these set, the Google button is simply hidden and email/password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Online payments with PayHere (optional; enable it under Online Store > Payments)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Public URL of the website, used for PayHere return/notify links (e.g. https://amilautohub.lk)
NEXT_PUBLIC_SITE_URL=
